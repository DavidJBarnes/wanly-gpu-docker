[Unit]
Description=Report A1111 LoRA usage to wanly-api every 15 minutes
Documentation=https://github.com/DavidJBarnes/wanly-gpu-docker/issues/211

[Timer]
# OnCalendar, not OnUnitActiveSec: an absolute schedule always has a next elapse (#76).
OnCalendar=*:0/15
RandomizedDelaySec=2min
Persistent=true

[Install]
WantedBy=timers.target
