# A SECOND container on the same host: the dedicated scene captioner (wanly-gpu-docker#163, #167).
# Copy to deploy/scene.env and fill in. NEVER commit the real file — it carries the queue key.
#
# On 3090a this runs JoyCaption on the RTX 2070, always resident, beside the 3090 worker
# (deploy/worker.env). Each container sees only its own card, by UUID:
#
#     WORKER_ENV=deploy/scene.env ./deploy/run-worker.sh
#
# run-worker.sh refuses before removing anything if NAME is missing (it would replace the 3090
# worker), if FRIENDLY_NAME is already used by another container, or if a port is taken.
#
# The update timer manages deploy/worker.env's container only. Update this one by hand: re-run
# the line above after changing IMAGE. A scene caption is a few seconds, so a recreate between
# captions costs nothing (the API falls back to the motion captioner while it is down).

# Its own container name and worker row. Both MUST differ from the 3090 worker's.
NAME=wanly-scene
FRIENDLY_NAME=3090a-scene
QUEUE_URL=http://api.wanly22.com:8001
QUEUE_API_KEY=

IMAGE=davidjbarnes/wanly-gpu-docker:full

# The 2070, by UUID: `nvidia-smi -L` on the host after the card is installed. An index is not
# stable across boots; a UUID is. The boot refuses unless the container sees exactly this card.
GPU_UUID=GPU-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# JoyCaption and the prompt enhancer. Both claim nothing; it registers as a `service`, so it never runs
# the render daemon and is never offered a segment.
SERVICES=scene-caption,prompt-enhance
# prompt-enhance (#225): the Sulphur-2 prompt enhancer, loaded per request on :11438. The 2070
# cannot hold it beside JoyCaption, so with both here scene-caption yields the card for a run
# of enhances and gets it back after PROMPT_ENHANCE_IDLE_S (120) without one. Its 6.2 GB of
# GGUFs are fetched into $OLLAMA_HOST_STORE/prompt-enhance on first boot.
#PROMPT_ENHANCE_PORT=11438
# Dedicated card: leave SCENE_CAPTION_SHARED unset. It is for a card shared with image-edit
# (3090b's interim setup), where every edit makes JoyCaption unload first.
#SCENE_CAPTION_SHARED=

# The host's ollama store, which already holds joycaption:beta-one on 3090a. The same store the
# 3090 worker's image-description mounts; the model is never rebuilt over a complete manifest.
OLLAMA_HOST_STORE=/home/david/.ollama

# Ports: wanly-api calls :11436 (scene_caption_url); the control port must differ from the 3090
# worker's 8081.
SCENE_CAPTION_PORT=11436
CONTROL_PORT=8088

# A small tenant: JoyCaption is ~6 GB of VRAM and a few GB of RAM. Cap it so a runaway here can't
# take the host's memory from the 3090 worker. If you add this, lower the 3090 worker's own
# WORKER_MEMORY_LIMIT by the same amount so the two together leave the host ~6-8 GB.
WORKER_MEMORY_LIMIT=8g

# The 3090's box holds only Wanly images, but pruning from a second script is still a surprise.
PRUNE_IMAGES=0
