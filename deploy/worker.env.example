# Host-side config for a long-lived worker (the 3090). Copy to deploy/worker.env and fill in.
# NEVER commit the real file — it carries the queue key.
#
# A RunPod pod gets these from the launcher's env dict (wanly-api runpod_client.worker_env).
# This is the same set for a box that is not launched by the API.

FRIENDLY_NAME=3090.zero
QUEUE_URL=http://api.wanly22.com:8001
QUEUE_API_KEY=

# Host paths bind-mounted into the container. The models tree is READ-ONLY on purpose: this
# box is the source of truth for 217 GB of weights and nothing in the container should be
# able to modify or delete them.
JOBS_DIR=/home/david/ltx-jobs
MODELS_DIR=/home/david/LTX-2/models

# 8188 is already taken on this host by Automatic1111's neighbour, hence 8191 outside.
COMFY_HOST_PORT=8191
ENGINE_HOST_PORT=8190

# Which services this container runs (wanly-gpu-docker#83). The default is the render stack;
# the 3090 runs everything. lora-trainer and image-description live in the :full tag only.
SERVICES=ltx-engine
#IMAGE=davidjbarnes/wanly-gpu-docker:full
#SERVICES=ltx-engine,lora-trainer,image-description,face-crop
#
# MODE (wanly-gpu-docker#131) -- the one-word lever, and it WINS OVER SERVICES above.
#
#     MODE=ltx-engine   render: the full line, from SERVICES_RENDER
#     MODE=caption      captions only, from SERVICES_CAPTION; queued jobs simply wait
#
# Set it here and `./run-worker.sh`, or override for one run: `MODE=caption ./run-worker.sh`.
# `wanly-mode.sh caption|render` writes this line for you and recreates in one step.
#
# NOTE this is the RECREATE path. To caption while a segment is in flight, use
# `wanly-mode.sh pause` instead -- it finishes the segment, parks and frees the card with no
# recreate, and `resume` processes everything that queued up meanwhile.
#MODE=ltx-engine
#SERVICES_RENDER=ltx-engine,lora-trainer,image-description,face-crop
#SERVICES_CAPTION=image-description,face-crop
# The supervisor's /health, read by the update timer.
CONTROL_PORT=8081

# lora-trainer: where run directories and their checkpoints land (writable).
#LORA_RUNS_DIR=/home/david/projects/loras
# image-description: the host's ollama model store and the port wanly-api calls
# (image_description_url). Two models are kept present: the ACTIVE one (IMAGE_DESCRIPTION_MODEL,
# pulled at boot if absent — any library tag) and the kept joycaption:beta-one (built at boot
# if absent — its tag is unpullable, see wanly_worker/services/image_description/model.py).
# run-worker.sh passes joycaption:beta-one as the default ON PURPOSE — it fits every GPU we
# own; Qwen-class captioners (6-21 GB) need a 24 GB card, so set this explicitly on such a box,
# e.g. IMAGE_DESCRIPTION_MODEL=qwen3-vl:32b-instruct-q4_K_M on the 3090 (wanly-gpu-docker#128).
#OLLAMA_HOST_STORE=/usr/share/ollama/.ollama
#IMAGE_DESCRIPTION_PORT=11434
#IMAGE_DESCRIPTION_MODEL=qwen3-vl:32b-instruct-q4_K_M
# face-crop: insightface's model cache and the port wanly-api calls (face_crop_url).
#INSIGHTFACE_HOST_DIR=/home/david/.insightface
#FACE_CROP_PORT=8084

# THE DEV MOUNT (wanly-gpu-docker#117): run engine/ and wanly_worker/ straight from a
# checkout on this box — edit on the host, `docker restart`, done. Both lines are required:
# DEV_CODE_DIR alone is refused, because a stale env line must never silently redirect a
# real worker onto a half-edit. While mounted, the boot log and /health shout
# "DEV MOUNT ... NOT DEPLOYED CODE" on every check.
#DEV_CODE_DIR=/home/david/projects/wanly-gpu-docker
#DEV_ALLOW_QUEUE=1
