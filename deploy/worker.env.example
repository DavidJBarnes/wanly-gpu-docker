# Host-side config for a long-lived worker (the 3090). Copy to deploy/worker.env and fill in.
# NEVER commit the real file — it carries the queue key.
#
# A RunPod pod gets these from the launcher's env dict (wanly-api runpod_client.worker_env).
# This is the same set for a box that is not launched by the API.

FRIENDLY_NAME=3090.zero
QUEUE_URL=http://api.wanly22.com:8001
QUEUE_API_KEY=

# Host paths bind-mounted into the container. The models tree is READ-ONLY on purpose: this
# box is the source of truth for 217 GB of weights and nothing in the container should be
# able to modify or delete them.
JOBS_DIR=/home/david/ltx-jobs
MODELS_DIR=/home/david/LTX-2/models

# 8188 is already taken on this host by Automatic1111's neighbour, hence 8191 outside.
COMFY_HOST_PORT=8191
ENGINE_HOST_PORT=8190

# Which services this container runs (wanly-gpu-docker#83). The default is the render stack;
# the 3090 runs everything. lora-trainer and image-description live in the :full tag only.
SERVICES=ltx-engine
#IMAGE=davidjbarnes/wanly-gpu-docker:full
#SERVICES=ltx-engine,lora-trainer,image-description,face-crop,face-edit,image-edit,scene-caption
#
# MODE (wanly-gpu-docker#131) -- the one-word lever, and it WINS OVER SERVICES above.
#
#     MODE=ltx-engine   everything in SERVICES (the default when MODE is unset)
#     MODE=caption      only the services that claim no work; queued jobs simply wait
#
# The CONTAINER reads MODE (wanly_worker/registry.py select_mode), so the switch is a plain
# docker flag -- `docker run -e MODE=caption ...` -- and SERVICES above is never rewritten:
# it stays this box's capability line, so there is no full list to remember and put back.
# Set it here and `./run-worker.sh`, override for one run with `MODE=caption ./run-worker.sh`,
# or let `wanly-mode.sh caption|render` write it and recreate in one step.
#
# NOTE this is the RECREATE path. To caption while a segment is in flight, use
# `wanly-mode.sh pause` instead -- it finishes the segment, parks and frees the card with no
# recreate, and `resume` processes everything that queued up meanwhile.
#MODE=ltx-engine
# The supervisor's /health, read by the update timer.
CONTROL_PORT=8081

# lora-trainer: where run directories and their checkpoints land (writable).
#LORA_RUNS_DIR=/home/david/projects/loras
# image-description: the host's ollama model store and the port wanly-api calls
# (image_description_url). Two models are kept present: the ACTIVE one (IMAGE_DESCRIPTION_MODEL,
# pulled at boot if absent — any library tag) and the kept joycaption:beta-one (built at boot
# if absent — its tag is unpullable, see wanly_worker/services/image_description/model.py).
# run-worker.sh passes joycaption:beta-one as the default ON PURPOSE — it fits every GPU we
# own; Qwen-class captioners (6-21 GB) need a 24 GB card, so set this explicitly on such a box,
# e.g. IMAGE_DESCRIPTION_MODEL=qwen3-vl:32b-instruct-q4_K_M on the 3090 (wanly-gpu-docker#128).
#OLLAMA_HOST_STORE=/usr/share/ollama/.ollama
#IMAGE_DESCRIPTION_PORT=11434
#IMAGE_DESCRIPTION_MODEL=qwen3-vl:32b-instruct-q4_K_M
# face-crop: insightface's model cache and the port wanly-api calls (face_crop_url).
#INSIGHTFACE_HOST_DIR=/home/david/.insightface
#FACE_CROP_PORT=8084
# face-edit (console#547): LivePortrait expression/gaze/head-turn edits; the port wanly-api calls
# (face_edit_url). :full tag only. Models are baked, nothing to mount. It borrows the GPU per
# edit only when no neighbour needs it and falls back to CPU otherwise (gpu.py). On the 2070,
# point it at the HOST's Automatic1111 so it can see a generation in progress and ask an idle
# A1111 to unload its checkpoint; leave it unset where there is no A1111 (the 3090).
#FACE_EDIT_PORT=8085
#FACE_EDIT_A1111_URL=http://host.docker.internal:7860
#FACE_EDIT_MIN_FREE_MIB=2560
#FACE_EDIT_CPU_FALLBACK=1
#FACE_EDIT_DEVICE=auto
#FACE_EDIT_GPU_IDLE_S=45
#
# A face-edit-only box (the 2070) needs no JOBS_DIR/MODELS_DIR and publishes no ComfyUI or
# engine port -- those are required only with ltx-engine or lora-trainer:
#   IMAGE=davidjbarnes/wanly-gpu-docker:full
#   FRIENDLY_NAME=2070.zero
#   SERVICES=face-edit
#   FACE_EDIT_A1111_URL=http://host.docker.internal:7860
#   PRUNE_IMAGES=0     # its Docker also holds other projects' images; see run-worker.sh

# image-edit (console#548): Qwen-Image-Edit full mode, EDIT MODE ONLY (POST :8081/mode). Needs the
# Qwen tree mounted read-only and insightface's store (INSIGHTFACE_HOST_DIR) for AuraFace.
#IMAGE_EDIT_MODELS_HOST_DIR=/home/david/models/qwen
#IMAGE_EDIT_PORT=8086
#EDIT_IDLE_RETURN_S=600
# The official 2511's template is 40 steps at CFG 4 (#574). Leave these unset; a leftover
# IMAGE_EDIT_STEPS=4 from the Rapid-AIO v23 days runs the official model at 4 steps.
#IMAGE_EDIT_STEPS=40
#IMAGE_EDIT_CFG=4
#
# A STANDING image-edit box (console#570): the second 3090 (ex-2070), Qwen full-time, no render
# stack, so no mode switch -- SERVICES=image-edit alone runs it in the box's default mode.
# wanly-api prefers it while it is healthy (image_edit_standing_url) and falls back to the main
# 3090's edit mode when it is not. It shares the card with the host's Automatic1111 by the rule
# in wanly_worker/services/image_edit/share.py: never start under a generation, unload an idle
# A1111 only when short of VRAM, give the card back as soon as A1111 starts generating.
#   IMAGE=davidjbarnes/wanly-gpu-docker:full-<sha>
#   FRIENDLY_NAME=2070.zero
#   QUEUE_URL=http://api.wanly22.com:8001
#   QUEUE_API_KEY=...
#   SERVICES=image-edit
#   IMAGE_EDIT_MODELS_HOST_DIR=/home/david/models/qwen   # base/ text_encoders/ vae/: the official 2511 set
#   INSIGHTFACE_HOST_DIR=/home/david/.insightface       # buffalo_l + AuraFace glintr100.onnx
#   IMAGE_EDIT_A1111_URL=http://host.docker.internal:7860
#   IMAGE_EDIT_UNLOAD_IDLE_S=120     # unload Qwen after 2 idle minutes (0 = stay resident)
#   IMAGE_EDIT_MIN_FREE_MIB=21504    # below this (Qwen not resident) an idle A1111 is unloaded
#   IMAGE_EDIT_A1111_WAIT_S=300      # an edit that arrives mid-generation waits this long, then 503
#   PRUNE_IMAGES=0                   # its Docker also holds other projects' images; see run-worker.sh

# scene-caption (wanly-console#572): JoyCaption Beta One for the <SCENE> half, on its own ollama,
# ALWAYS RESIDENT, on :11436 (wanly-api scene_caption_url). :full tag only. Uses the same host
# store as image-description (OLLAMA_HOST_STORE); joycaption:beta-one is used as it is if the
# store has it, otherwise rebuilt at boot from the two public GGUFs (~5.8 GB).
#SCENE_CAPTION_PORT=11436
# Throttle the boot-time rebuild (curl --limit-rate spelling) on a box behind the shared link.
#MODEL_LIMIT_RATE=3M
# Only where the card is SHARED with image-edit (3090b, interim): every edit asks JoyCaption to
# unload first, and image-edit hands the card back after IMAGE_EDIT_SCENE_RESUME_IDLE_S idle.
# Leave it off on a dedicated card (the 2070 in 3090a's box, phase 2).
#SCENE_CAPTION_SHARED=1
#IMAGE_EDIT_SCENE_RESUME_IDLE_S=60
#SCENE_CAPTION_YIELD_WAIT_S=600
#
# 3090b, interim (image-edit full-time + scene captions on one card):
#   SERVICES=image-edit,scene-caption
#   OLLAMA_HOST_STORE=/usr/share/ollama/.ollama
#   SCENE_CAPTION_SHARED=1
#   PRUNE_IMAGES=0

# THE DEV MOUNT (wanly-gpu-docker#117): run engine/ and wanly_worker/ straight from a
# checkout on this box — edit on the host, `docker restart`, done. Both lines are required:
# DEV_CODE_DIR alone is refused, because a stale env line must never silently redirect a
# real worker onto a half-edit. While mounted, the boot log and /health shout
# "DEV MOUNT ... NOT DEPLOYED CODE" on every check.
#DEV_CODE_DIR=/home/david/projects/wanly-gpu-docker
#DEV_ALLOW_QUEUE=1
